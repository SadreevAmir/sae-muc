# HuggingFace token — required on the server for gated models (Mistral, Llama).
HF_TOKEN=hf_xxx

# OpenRouter API key — OpenAI-compat proxy; used when judge.provider == openrouter.
OPENROUTER_API_KEY=sk-or-xxx

# CherryIn (New-API proxy) key — alternative judge provider for regions where
# OpenRouter routing is unreliable. Used when judge.provider == cherryin.
CHERRYIN_API_KEY=
